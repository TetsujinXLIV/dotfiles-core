{
  // --------------------------------------------------------------------------
  // APPEARANCE & THEME
  // Settings that control the visual appearance of the editor, including
  // the color theme, icon theme, and font configurations.
  // --------------------------------------------------------------------------
  "workbench.colorTheme": "Tokyo Night",
  "workbench.iconTheme": "catppuccin-mocha",
  "editor.fontFamily": "'DejaVu Sans Mono for Powerline', fira-code-nerd, FiraCode Nerd Font, Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "terminal.integrated.fontFamily": "FiraMono NF",
  "terminal.integrated.customGlyphs": true,
  "terminal.integrated.defaultProfile.linux": "bash",

  // --------------------------------------------------------------------------
  // GENERAL EDITOR SETTINGS
  // Core editor configurations like tab size, whitespace rendering, rulers,
  // and behavior of features like the minimap and suggestions.
  // --------------------------------------------------------------------------
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "editor.renderWhitespace": "trailing",
  "editor.rulers": [80],
  "editor.minimap.enabled": false,
  "editor.inlineSuggest.suppressSuggestions": true,
  "diffEditor.codeLens": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.formatOnSave": true,
  "git.autoRepositoryDetection": "open",
  "git.ignoredRepositories": [
    "**/.claude-code/**",
    "**/.codex/**",
    "**/.gemini/**",
  ],

  // --------------------------------------------------------------------------
  // FILE & WORKSPACE
  // Settings related to file management, workspace trust, and the overall
  // workbench behavior on startup.
  // --------------------------------------------------------------------------
  "files.autoSave": "afterDelay",
  "files.associations": {
    "Makefile.*": "makefile",
    "*.jsonc": "jsonc",
  },
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
  "security.workspace.trust.untrustedFiles": "open",
  "workbench.startupEditor": "none",

  // --------------------------------------------------------------------------
  // GIT INTEGRATION
  // Settings for VS Code's built-in Git functionality.
  // --------------------------------------------------------------------------
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "git.autorefresh": true,
  "git.confirmSync": false,

  // --------------------------------------------------------------------------
  // REMOTE DEVELOPMENT & SYNC
  // Configuration for remote development (SSH, Tunnels) and settings sync.
  // --------------------------------------------------------------------------
  "remote.tunnels.alwaysUpdateCLI": true,
  "remote.SSH.configFile": "/home/david/.ssh/config",
  "settingsSync.ignoredSettings": ["remote.SSH.configFile"],

  // --------------------------------------------------------------------------
  // LANGUAGE-SPECIFIC SETTINGS
  // Overrides for specific languages, allowing for different formatting
  // and editor behaviors depending on the file type.
  // --------------------------------------------------------------------------
  "[python]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit",
    },
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.wordWrap": "on",
    "editor.formatOnSave": true,
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
    "editor.formatOnSave": true,
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "docker.extension.dockerEngineAvailabilityPrompt": false,
  // --------------------------------------------------------------------------
  // PYTHON TOOLING
  // Specific settings for Python linting and formatting tools.
  // --------------------------------------------------------------------------
  "ruff.configuration": "~/dotfiles/ruff.toml",
  "python.analysis.autoFormatStrings": true,
  "python.analysis.completeFunctionParens": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // --------------------------------------------------------------------------
  // SHELL FORMATTING
  // Configuration for shell script formatters like shfmt and bash-beautify.
  // --------------------------------------------------------------------------
  "shellformat.flag": "-i 2",
  "shellformat.effectLanguages": [
    "dockerfile",
    "dotenv",
    "hosts",
    "jvmoptions",
    "ignore",
    "gitignore",
    "properties",
    "spring-boot-properties",
    "azcli",
    "bats",
  ],
  "bashBeautify.tabSize": 2,

  // --------------------------------------------------------------------------
  // PRETTIER FORMATTER
  // Settings for the Prettier code formatter.
  // --------------------------------------------------------------------------
  "prettier.printWidth": 80,
  "prettier.proseWrap": "always",

  // --------------------------------------------------------------------------
  // FILE TRIMMING & FORMATTING
  // Native VS Code settings for whitespace and final newlines.
  // --------------------------------------------------------------------------
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },

  // --------------------------------------------------------------------------
  // MISCELLANEOUS
  // Other settings that don't fit into the above categories.
  // --------------------------------------------------------------------------
  "json_schemas": [],
  "workbench.settings.applyToAllProfiles": [],
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  // Disable copilot garbage
  "github.copilot.enable": {
    "*": false,
  },
  "remote.SSH.experimental.chat": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "zoo-code.vsCodeLmModelSelector": {},
  "zoo-code.debug": false,
  "zoo-code.allowedCommands": ["git log", "git diff", "git show"],
  "zoo-code.deniedCommands": [],
  "zoo-code.autoImportSettingsPath": "~/.config/zoo-code/settings.json",
}
